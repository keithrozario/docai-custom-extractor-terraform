# ==============================================================================
# Document AI Custom Extractor Terraform Variables
# ==============================================================================

# OPTIONAL: GCP Project ID. 
# If omitted or left as null/empty string, Terraform automatically detects and 
# uses your active default project configured in gcloud (`gcloud config get-value project`).
# project_id             = "your-gcp-project-id"

region                 = "us-central1"
location               = "us"
processor_display_name = "docai-custom-extractor"
create_gcs_bucket      = true
enable_apis            = true
apply_schema           = true
schema_file            = "schema.json"
create_dataset         = true
